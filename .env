# Base origin of the deployed backend API (no trailing slash, no /api/v1
# suffix — that's already part of each call site's path).
#
# Committed with the current Railway deployment's URL so the app works
# connected out of the box. If you redeploy the backend elsewhere, update
# this value (and the backend's FRONTEND_URL env var to match wherever
# *this* app ends up running, for CORS).
VITE_API_BASE_URL=https://uip-production-0231.up.railway.app
